{#
| Variable                 | Type     | Description
|--------------------------|----------|--------------------------------------------
| component.title          | string   | Section title
| component.description    | string   | Section description
| component.background     | string   | Background style
| component.card_style     | string   | Card visual style
| component.mobile_layout  | string   | swipe or grid
| component.items          | object[] | Category/navigation cards
| component.items[].image  | string   | Uploaded icon/image
| component.items[].title  | string   | Card title
| component.items[].text   | string   | Card description
| component.items[].count  | string   | Optional product count
| component.items[].badge  | string   | Optional badge
| component.items[].url    | string   | Destination URL
#}
{% set section_id = 'zod-smart-category-nav-' ~ position %}
<section class="s-block zod-section zod-smart-category-nav zod-smart-category-nav--{{ component.background ?: 'luxury_dark' }} zod-smart-category-nav--cards-{{ component.card_style ?: 'glass' }} zod-smart-category-nav--mobile-{{ component.mobile_layout ?: 'swipe' }}" id="{{ section_id }}">
  <div class="container">
    <div class="s-block__title zod-smart-category-nav__heading">
      <div class="right-side">
        <span class="zod-smart-category-nav__eyebrow">{{ component.eyebrow ?: 'Premium Solutions Explorer' }}</span>
        <h2>{{ component.title ?: 'استكشف حلول زد' }}</h2>
        {% if component.description %}<p>{{ component.description }}</p>{% endif %}
      </div>
    </div>

    <div class="zod-smart-category-nav__grid" style="--zod-nav-columns: {{ component.columns ?: 4 }}; --zod-nav-radius: {{ component.border_radius ?: 24 }}px; --zod-nav-glow: {{ component.glow_intensity ?: 0.18 }}; --zod-nav-icon-size: {{ component.icon_size ?: 56 }}px;">
      {% for item in component.items %}
        {% if item.title %}
          <a class="zod-smart-category-card" href="{{ item.url ?: '#' }}" {% if item.image_mode == 'background' and item.image %}style="--zod-card-bg-image: url('{{ item.image }}');"{% endif %}>
            {% if item.badge %}<span class="zod-smart-category-card__badge">{{ item.badge }}</span>{% endif %}
            <div class="zod-smart-category-card__shine"></div>

            {% if item.image and item.image_mode != 'background' %}
              <span class="zod-smart-category-card__icon">
                <img src="{{ item.image }}" alt="{{ item.title }}" loading="lazy">
              </span>
            {% else %}
              <span class="zod-smart-category-card__icon zod-smart-category-card__icon--empty"><span></span></span>
            {% endif %}

            <div class="zod-smart-category-card__content">
              <h3>{{ item.title }}</h3>
              {% if item.text %}<p>{{ item.text }}</p>{% endif %}
              {% if item.count %}<strong class="zod-smart-category-card__count">{{ item.count }}</strong>{% endif %}
            </div>

            {% if component.show_arrow is not same as(false) %}
              <span class="zod-smart-category-card__arrow" aria-hidden="true"><i class="sicon-arrow-left"></i></span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
