<footer class="store-footer zod-footer zod-footer--refined zod-footer--no-accordion">
  <div class="zod-footer__glow-line" aria-hidden="true"></div>

  <div aria-label="footer" class="store-footer__inner zod-footer__inner">
    <div class="container zod-footer__grid zod-footer__grid--three">
      <section class="zod-footer__brand">
        <a href="{{ link('/') }}" class="zod-footer__brand-link" aria-label="{{ store.name }}">
          {% if store.logo %}
            <img src="{{ store.logo }}" alt="{{ store.name }}" loading="lazy">
          {% endif %}
          <h3>{{ store.name }}</h3>
        </a>

        {% if store.description %}
          <div class="zod-footer__description">
            {{ store.description|raw }}
          </div>
        {% else %}
          <p class="zod-footer__description">حلول احترافية للإنتركوم والكاميرات والشبكات وأنظمة التحكم.</p>
        {% endif %}

        <div class="zod-footer__mini-trust" aria-label="ZOD trust highlights">
          <span>دفع آمن</span>
          <span>ضمان واضح</span>
          <span>دعم فني</span>
        </div>
      </section>

      <section class="zod-footer__section">
        <h3>روابط مهمة</h3>
        <div class="zod-footer__section-content">
          <salla-menu source="footer" with-cookie-preferences></salla-menu>
        </div>
      </section>

      <section class="zod-footer__section zod-footer__contact zod-footer__contact--native-title">
        <div class="zod-footer__section-content">
          <salla-contacts></salla-contacts>
          <div class="zod-footer__social">
            <salla-social></salla-social>
          </div>
        </div>
      </section>
    </div>

    <div class="container zod-footer__meta-row">
      <div class="zod-footer__badges">
        <salla-trust-badges dark></salla-trust-badges>
        {% if store.settings.tax.number %}
          <div class="zod-footer__tax">
            {% if store.settings.tax.certificate %}
              <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                <img width="40" height="50" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" alt="value added tax">
              </a>
            {% endif %}
            <div>
              <p>{{ trans('common.elements.tax_number') }}</p>
              <b>{{ store.settings.tax.number }}</b>
            </div>
          </div>

          {% if store.settings.tax.certificate %}
            <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="zod-footer__bottom">
    <div class="container zod-footer__bottom-inner">
      <span class="copyright-text">{% hook copyright %}</span>
      <salla-payments></salla-payments>
    </div>
  </div>

  <span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span>
</footer>
