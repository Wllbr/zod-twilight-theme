{#
| Variable                         | Type      | Description
|----------------------------------|-----------|--------------------------------------------
| component.title                  | string    | Custom section title
| component.description            | string    | Custom section description
| component.main_category          | Category  | Parent category (used as label/source only)
| component.subcategory_tabs       | object[]  | Manually selected subcategory tabs
| component.subcategory_tabs[].category | Category | The subcategory for this tab
| component.subcategory_tabs[].custom_title | string | Optional custom tab title
| component.subcategory_tabs[].products | Product[] | Manually selected products for this tab
| component.display_mode           | string    | slider or grid
| component.limit                  | int       | Number of products per tab
| component.show_category_image    | bool      | Show child category image in tab
| component.show_view_all          | bool      | Show View All button
| component.autoplay_slider        | bool      | Enable slider autoplay
#}
{% set component_id = 'zod-nested-category-showcase-' ~ position %}
{% set parent_category = component.main_category[0] is defined ? component.main_category[0] : component.main_category %}
{% set tabs = component.subcategory_tabs ?: [] %}
{% set display_mode = component.display_mode ?: 'slider' %}
{% set product_limit = component.limit ?: 8 %}

<section class="s-block s-block-tabs zod-section zod-nested-category-showcase" id="{{ component_id }}">
  <div class="container">
    {# ── Section Header ── #}
    <div class="s-block__title zod-nested-category-showcase__title">
      <div class="right-side">
        <h2>{{ component.title ?: parent_category.name ?: 'منتجات حسب التصنيف' }}</h2>
        {% if component.description %}
          <p class="zod-nested-category-showcase__description">{{ component.description }}</p>
        {% elseif parent_category.description is defined and parent_category.description %}
          <p class="zod-nested-category-showcase__description">{{ parent_category.description|striptags }}</p>
        {% endif %}
      </div>
      {% if component.show_view_all and parent_category.url is defined and parent_category.url %}
        <a href="{{ parent_category.url }}" class="s-block__display-all">عرض الكل <i class="sicon-arrow-left"></i></a>
      {% endif %}
    </div>

    {# ── Tabs & Panels (Manual Subcategory Selection Only) ── #}
    {% if tabs|length %}
      {# ── Tab Buttons ── #}
      <div class="zod-nested-category-showcase__tabs tabs hide-scroll" role="tablist">
        {% for tab in tabs %}
          {% set tab_category = tab.category[0] is defined ? tab.category[0] : tab.category %}
          {% set tab_title = tab.custom_title ?: (tab_category.name is defined ? tab_category.name : 'تبويب ' ~ loop.index) %}
          {% set tab_id = component_id ~ '-tab-' ~ loop.index %}
          {% if tab.products|length %}
            <salla-button
              shape="link"
              class="tab-trigger zod-nested-category-showcase__tab {{ loop.first ? 'is-active' : '' }}"
              data-target="{{ tab_id }}"
              data-component-id="{{ component_id }}">
              {% if component.show_category_image and tab_category.image is defined and tab_category.image %}
                <img src="{{ tab_category.image }}" alt="{{ tab_title }}" loading="lazy">
              {% endif %}
              <span>{{ tab_title }}</span>
            </salla-button>
          {% endif %}
        {% endfor %}
      </div>

      {# ── Tab Panels with Manually Selected Products ── #}
      <div class="tabs-wrapper zod-nested-category-showcase__panels">
        {% for tab in tabs %}
          {% set tab_category = tab.category[0] is defined ? tab.category[0] : tab.category %}
          {% set tab_title = tab.custom_title ?: (tab_category.name is defined ? tab_category.name : 'تبويب ' ~ loop.index) %}
          {% set panel_id = component_id ~ '-tab-' ~ loop.index %}
          {% if tab.products|length %}
            <div id="{{ panel_id }}" class="tabs__item zod-nested-category-showcase__panel {{ loop.first ? 'is-active opacity-100 translate-y-0' : 'opacity-0 translate-y-3' }}" role="tabpanel">
              {# Panel heading #}
              <div class="zod-nested-category-showcase__panel-heading">
                <div>
                  <h3>{{ tab_title }}</h3>
                  {% if tab_category.description is defined and tab_category.description %}
                    <p>{{ tab_category.description|striptags }}</p>
                  {% endif %}
                </div>
                {% if component.show_view_all and tab_category.url is defined and tab_category.url %}
                  <a href="{{ tab_category.url }}" class="zod-button--ghost">عرض كل المنتجات</a>
                {% endif %}
              </div>

              {# Manually selected products #}
              {% set selected_products = tab.products|slice(0, product_limit) %}
              {% set product_ids = [] %}
              {% for product in selected_products %}
                {% set product_ids = product_ids|merge([product.id is defined ? product.id : product]) %}
              {% endfor %}

              {% if display_mode == 'grid' %}
                <salla-products-list
                  source="selected"
                  source-value="[{{ product_ids|join(',') }}]"
                  limit="{{ product_limit }}"
                  class="vertical-products zod-nested-category-showcase__products">
                </salla-products-list>
              {% else %}
                <salla-products-slider
                  slider-id="{{ panel_id }}-slider"
                  source="selected"
                  source-value="[{{ product_ids|join(',') }}]"
                  limit="{{ product_limit }}"
                  {{ component.autoplay_slider ? 'autoplay' : '' }}>
                </salla-products-slider>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      {# ── Empty State ── #}
      <div class="zod-nested-category-showcase__empty">
        أضف تبويبات التصنيفات الفرعية يدوياً من إعدادات المكون، واختر المنتجات لكل تبويب.
      </div>
    {% endif %}
  </div>
</section>
