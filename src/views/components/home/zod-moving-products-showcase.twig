{#
| Variable                         | Type      | Description
|----------------------------------|-----------|-------------------------------------------------------------
| component.title                  | string    | Editable section title
| component.subtitle               | string    | Optional subtitle under the title
| component.source_type            | string    | latest, category, offers, selected, tags, best_selling, random, highest_rated
| component.categories             | array     | Categories selected when source_type is category
| component.selected_products      | array     | Products selected when source_type is selected/featured
| component.product_tags           | array     | Tags selected when source_type is tags
| component.product_count          | int       | Number of products shown in the slider
| component.auto_moving            | bool      | Enable continuous smooth motion enhancement
| component.motion_speed           | int       | Motion speed in seconds
| component.pause_on_hover         | bool      | Pause/slow movement on hover
#}

{% set component_id = 'zod-moving-products-showcase-' ~ position %}
{% set source_type = component.source_type|default('latest') %}
{% set product_limit = component.product_count|default(12) %}
{% set section_title = component.title|default('أحدث المنتجات') %}
{% set section_subtitle = component.subtitle|default('') %}
{% set auto_moving = component.auto_moving is same as(false) ? false : true %}
{% set motion_speed = component.motion_speed|default(42) %}
{% set pause_on_hover = component.pause_on_hover is same as(false) ? false : true %}
{% set show_display_all = component.show_display_all is same as(false) ? false : true %}

{% set slider_source = 'latest' %}
{% set slider_source_value = null %}
{% set sort_by = null %}
{% set display_all_url = null %}

{% if source_type == 'category' %}
    {% set slider_source = 'categories' %}
    {% set slider_source_value = component.categories|default([])|map((category) => category.id)|json_encode %}
    {% set display_all_url = component.categories|default([])|length ? component.categories|first.url : null %}
{% elseif source_type == 'offers' %}
    {% set slider_source = 'offers' %}
{% elseif source_type == 'selected' or source_type == 'featured' %}
    {% set slider_source = 'selected' %}
    {% set slider_source_value = component.selected_products|default([])|map((product) => product.id)|json_encode %}
{% elseif source_type == 'tags' %}
    {% set slider_source = 'tags' %}
    {% set slider_source_value = component.product_tags|default([])|map((tag) => tag.id)|json_encode %}
{% elseif source_type == 'best_selling' %}
    {% set slider_source = 'latest' %}
    {% set sort_by = 'best_selling' %}
{% elseif source_type == 'highest_rated' %}
    {% set slider_source = 'latest' %}
    {% set sort_by = 'top_rating' %}
{% elseif source_type == 'random' %}
    {% set slider_source = 'latest' %}
    {% set sort_by = 'random' %}
{% endif %}

<section
    id="{{ component_id }}"
    class="s-block zod-moving-products-showcase {{ auto_moving ? 'zod-moving-products-showcase--auto' : '' }} {{ pause_on_hover ? 'zod-moving-products-showcase--pause-hover' : '' }}"
    data-zod-moving-products-showcase
    data-motion-enabled="{{ auto_moving ? 'true' : 'false' }}"
    data-motion-speed="{{ motion_speed }}"
    style="--zod-showcase-speed: {{ motion_speed }}s;"
>
    <div class="container">
        <div class="zod-moving-products-showcase__head">
            <div class="zod-moving-products-showcase__copy">
                <span class="zod-moving-products-showcase__eyebrow">ZOD PREMIUM</span>
                <h2 class="zod-moving-products-showcase__title">{{ section_title }}</h2>
                {% if section_subtitle %}
                    <p class="zod-moving-products-showcase__subtitle">{{ section_subtitle }}</p>
                {% endif %}
            </div>

            {% if show_display_all and display_all_url %}
                <a class="zod-moving-products-showcase__link" href="{{ display_all_url }}">
                    {{ trans('blocks.home.display_all') }}
                    <i class="sicon-arrow-left"></i>
                </a>
            {% endif %}
        </div>

        <div class="zod-moving-products-showcase__stage">
            <div class="zod-moving-products-showcase__edge zod-moving-products-showcase__edge--start" aria-hidden="true"></div>
            <div class="zod-moving-products-showcase__edge zod-moving-products-showcase__edge--end" aria-hidden="true"></div>

            <salla-products-slider
                class="zod-moving-products-showcase__slider"
                slider-id="{{ component_id }}-slider"
                source="{{ slider_source }}"
                limit="{{ product_limit }}"
                {% if auto_moving %}autoplay{% endif %}
                {% if slider_source_value %}source-value="{{ slider_source_value }}"{% endif %}
                {% if sort_by %}sort-by="{{ sort_by }}"{% endif %}
                product-card-component="custom-salla-product-card"
            ></salla-products-slider>
        </div>
    </div>
</section>
