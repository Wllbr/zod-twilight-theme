{#
| Variable                 | Type     | Description
|--------------------------|----------|--------------------------------------------
| component.title          | string   | Section title
| component.description    | string   | Section description
| component.items          | object[] | Category/link cards from twilight.json
| component.items[].image  | string   | Uploaded icon image, recommended 96×96 px
| component.items[].title  | string   | Card title
| component.items[].text   | string   | Card description
| component.items[].url    | string   | Destination URL
#}
<section class="s-block zod-section zod-category-shortcuts" id="zod-categories-{{ position }}">
  <div class="container">
    <div class="s-block__title">
      <div class="right-side">
        <h2>{{ component.title ?: 'تصفح حلول زد' }}</h2>
        {% if component.description %}<p>{{ component.description }}</p>{% endif %}
      </div>
    </div>

    <div class="zod-card-grid">
      {% for item in component.items %}
        {% if item.title %}
          <a class="zod-glass-card" href="{{ item.url ?: '#' }}">
            <span class="zod-image-icon">
              {% if item.image %}
                <img src="{{ item.image }}" width="48" height="48" alt="{{ item.title }}" loading="lazy">
              {% else %}
                <span class="zod-image-icon__placeholder"></span>
              {% endif %}
            </span>
            <h3>{{ item.title }}</h3>
            {% if item.text %}<p>{{ item.text }}</p>{% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
