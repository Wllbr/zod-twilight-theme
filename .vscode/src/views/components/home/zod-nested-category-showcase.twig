{#
| Variable                         | Type      | Description
|----------------------------------|-----------|--------------------------------------------
| component.title                  | string    | Custom section title
| component.description            | string    | Custom section description
| component.main_category          | Category  | Parent category selected by merchant
| component.child_categories       | Category[]| Manual fallback child categories
| component.manual_groups          | object[]  | Optional manual product tabs
| component.display_mode           | string    | slider or grid
| component.limit                  | int       | Number of products per tab
| component.show_category_image    | bool      | Show child category image in tab
| component.show_view_all          | bool      | Show View All button for each child category
| component.autoplay_slider        | bool      | Enable slider autoplay
#}
{% set component_id = 'zod-nested-category-showcase-' ~ position %}
{% set parent_category = component.main_category[0] is defined ? component.main_category[0] : component.main_category %}
{% set auto_children = parent_category.sub_categories is defined and parent_category.sub_categories|length ? parent_category.sub_categories : [] %}
{% set child_categories = auto_children|length ? auto_children : component.child_categories %}
{% set display_mode = component.display_mode ?: 'slider' %}
{% set product_limit = component.limit ?: 8 %}

<section class="s-block s-block-tabs zod-section zod-nested-category-showcase" id="{{ component_id }}">
  <div class="container">
    <div class="s-block__title zod-nested-category-showcase__title">
      <div class="right-side">
        <h2>{{ component.title ?: parent_category.name ?: 'منتجات حسب التصنيف' }}</h2>
        {% if component.description %}
          <p class="zod-nested-category-showcase__description">{{ component.description }}</p>
        {% elseif parent_category.description %}
          <p class="zod-nested-category-showcase__description">{{ parent_category.description|striptags }}</p>
        {% endif %}
      </div>
      {% if component.show_view_all and parent_category.url %}
        <a href="{{ parent_category.url }}" class="s-block__display-all">عرض الكل <i class="sicon-arrow-left"></i></a>
      {% endif %}
    </div>

    {% if child_categories|length or component.manual_groups|length %}
      <div class="zod-nested-category-showcase__tabs tabs hide-scroll" role="tablist">
        {% for category in child_categories %}
          {% set tab_id = component_id ~ '-category-' ~ category.id %}
          <salla-button
            shape="link"
            class="tab-trigger zod-nested-category-showcase__tab {{ loop.first ? 'is-active' : '' }}"
            data-target="{{ tab_id }}"
            data-component-id="{{ component_id }}">
            {% if component.show_category_image and category.image %}
              <img src="{{ category.image }}" alt="{{ category.name }}" loading="lazy">
            {% endif %}
            <span>{{ category.name }}</span>
          </salla-button>
        {% endfor %}

        {% set categories_count = child_categories|length %}
        {% for group in component.manual_groups %}
          {% if group.title and group.products|length %}
            {% set tab_id = component_id ~ '-manual-' ~ loop.index %}
            <salla-button
              shape="link"
              class="tab-trigger zod-nested-category-showcase__tab {{ categories_count == 0 and loop.first ? 'is-active' : '' }}"
              data-target="{{ tab_id }}"
              data-component-id="{{ component_id }}">
              <span>{{ group.title }}</span>
            </salla-button>
          {% endif %}
        {% endfor %}
      </div>

      <div class="tabs-wrapper zod-nested-category-showcase__panels">
        {% for category in child_categories %}
          {% set panel_id = component_id ~ '-category-' ~ category.id %}
          <div id="{{ panel_id }}" class="tabs__item zod-nested-category-showcase__panel {{ loop.first ? 'is-active opacity-100 translate-y-0' : 'opacity-0 translate-y-3' }}" role="tabpanel">
            <div class="zod-nested-category-showcase__panel-heading">
              <div>
                <h3>{{ category.name }}</h3>
                {% if category.description %}<p>{{ category.description|striptags }}</p>{% endif %}
              </div>
              {% if component.show_view_all and category.url %}
                <a href="{{ category.url }}" class="zod-button--ghost">عرض كل المنتجات</a>
              {% endif %}
            </div>

            {% if display_mode == 'grid' %}
              <salla-products-list
                source="categories"
                source-value="[{{ category.id }}]"
                limit="{{ product_limit }}"
                class="vertical-products zod-nested-category-showcase__products">
              </salla-products-list>
            {% else %}
              <salla-products-slider
                slider-id="{{ panel_id }}-slider"
                source="categories"
                source-value="[{{ category.id }}]"
                limit="{{ product_limit }}"
                {{ component.autoplay_slider ? 'autoplay' : '' }}>
              </salla-products-slider>
            {% endif %}
          </div>
        {% endfor %}

        {% set categories_count = child_categories|length %}
        {% for group in component.manual_groups %}
          {% if group.title and group.products|length %}
            {% set panel_id = component_id ~ '-manual-' ~ loop.index %}
            <div id="{{ panel_id }}" class="tabs__item zod-nested-category-showcase__panel {{ categories_count == 0 and loop.first ? 'is-active opacity-100 translate-y-0' : 'opacity-0 translate-y-3' }}" role="tabpanel">
              <div class="zod-nested-category-showcase__panel-heading">
                <div>
                  <h3>{{ group.title }}</h3>
                  {% if group.description %}<p>{{ group.description }}</p>{% endif %}
                </div>
              </div>
              <div class="zod-nested-category-showcase__manual-grid">
                {% for product in group.products|slice(0, product_limit) %}
                  <custom-salla-product-card product="{{ product }}"></custom-salla-product-card>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="zod-nested-category-showcase__empty">
        اختر تصنيفاً رئيسياً يحتوي على تصنيفات فرعية، أو أضف تصنيفات فرعية يدوياً من إعدادات المكون.
      </div>
    {% endif %}
  </div>
</section>
