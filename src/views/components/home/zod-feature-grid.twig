{#
| Variable                 | Type     | Description
|--------------------------|----------|--------------------------------------------
| component.title          | string   | Section title
| component.description    | string   | Section description
| component.features       | object[] | Feature cards
| component.features[].icon| string   | Salla icon class
| component.features[].title|string  | Feature title
| component.features[].text| string   | Feature description
#}
<section class="s-block zod-section zod-feature-grid" id="zod-features-{{ position }}">
  <div class="container">
    <div class="s-block__title">
      <div class="right-side">
        <h2>{{ component.title ?: 'لماذا تختار زد؟' }}</h2>
        {% if component.description %}<p>{{ component.description }}</p>{% endif %}
      </div>
    </div>

    <div class="zod-card-grid">
      {% for feature in component.features %}
        {% if feature.title %}
          <article class="zod-glass-card">
            <i class="{{ feature.icon ?: 'sicon-award-ribbon' }}"></i>
            <h3>{{ feature.title }}</h3>
            {% if feature.text %}<p>{{ feature.text }}</p>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
